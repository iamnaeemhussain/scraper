{
  "name": "scraper",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-04-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAKTEL_STORE",
        "class_name": "PakTelStoreDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PakTelStoreDO"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
