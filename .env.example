# ---------------------------------------------------------------------------
# LeadBridge configuration
# Copy this file to .env (`cp .env.example .env`) and edit the values.
# Every setting is optional in development; the defaults are safe for a laptop.
# NEVER commit the real .env — it holds your secrets.
# ---------------------------------------------------------------------------

# development | production
ENVIRONMENT=development
DEBUG=false

# ------------------------------------------------------------------ database
# SQLite (default, zero config): a single file on disk.
# DATABASE_URL=sqlite:///./backend/data/leadbridge.db
#
# PostgreSQL (recommended for more than a handful of users):
# DATABASE_URL=postgresql+psycopg://leadbridge:password@localhost:5432/leadbridge

# ---------------------------------------------------------------------- auth
# REQUIRED in production: generate with `python -c "import secrets;print(secrets.token_urlsafe(48))"`
SECRET_KEY=dev-only-change-me-please-set-SECRET_KEY-in-env
ACCESS_TOKEN_EXPIRE_MINUTES=720
COOKIE_SECURE=false          # set true when served over HTTPS
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------- extraction
# auto | scrapling | httpx  (auto uses Scrapling when installed)
FETCH_ENGINE=auto
USER_AGENT=LeadBridgeBot/1.0 (+compliance contact: compliance@example.com)
RESPECT_ROBOTS_TXT=true
HTTP_TIMEOUT_SECONDS=15

# Live extraction only works against these domains. Comma separated, no scheme.
# Leave empty to disable live collection entirely (demo + import still work).
ALLOWED_LIVE_DOMAINS=

# ------------------------------------------------------------- rate limiting
RATE_LIMIT_PER_MINUTE=240
LOGIN_RATE_LIMIT_PER_MINUTE=12
PUBLIC_FORM_RATE_LIMIT_PER_MINUTE=20

# --------------------------------------------------------------- demo data
# Seeds a rich demo dataset on first start (never runs when ENVIRONMENT=production)
SEED_DEMO_DATA=true
DEMO_MODE_ENABLED=true

# ------------------------------------------------- licensed adapter secrets
# Referenced by a source's `credential_env` field. Keep the real key in the
# server environment only — it is never sent to the browser.
# LICENSED_DB_API_KEY=
# PARTNER_CONTACT_API_KEY=
