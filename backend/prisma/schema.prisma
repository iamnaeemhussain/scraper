// Pak-Tel eSIM Store — PostgreSQL Schema Reference
// Base: recepasan/openesim-application, extended for Admin Bundles, Yesim Partner API, and DPay (PKR)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String?
  phone           String?
  passwordHash    String
  role            String    @default("USER") // "USER" | "ADMIN"
  yesimUserId     String?
  emailVerifiedAt DateTime?
  locale          String    @default("en")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
}

model Bundle {
  id                 String   @id @default(uuid())
  slug               String   @unique
  name               String   // Plan Name (e.g. "15 GB 30 Days", "Trial Plan")
  yesimPlanId        String   // Plan ID from Yesim Partner API (32-char hex or numeric)
  pricePkr           Int      // Price (PKR) - whole rupees
  actualPricePkr     Int?     // Actual Price (PKR) - compare-at price
  discountPct        Int      @default(0) // Discount %
  priceDifferencePkr Int      @default(0) // Price difference (Actual - Price)
  dataLabel          String   // GBs (e.g. "0.5 GB", "15 GB", "Unlimited Data")
  dataGb             Float?   // Numeric GBs for sorting/filtering; null if unlimited
  isUnlimited        Boolean  @default(false)
  validityDays       Int      // Days (e.g. 1, 7, 15, 30)
  isReloadable       Boolean  @default(true)  // Reloadable
  isMostPopular      Boolean  @default(false) // Most Popular
  costPkr            Float    @default(0)     // Cost (PKR)
  costEur            Float?                   // Cost (EUR)
  eurToPkr           Float    @default(303.8602) // EUR to PKR
  commissionPkr      Float    @default(0)     // Comission (PKR)
  contact            String?                  // Contact (WhatsApp number)
  message            String?                  // Message (Promo / WhatsApp note)
  countryCode        String   @default("PK")
  countryName        String   @default("Pakistan")
  coverage           String   @default("5G/4G/LTE")
  operators          String   @default("Jazz (Mobilink) Pakistan")
  planType           String   @default("Data only")
  hotspot            Boolean  @default(true)
  activationType     String   @default("Instant")
  apn                String   @default("plus")
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Order {
  id                 String    @id @default(uuid())
  orderNumber        String    @unique
  publicAccessToken  String    @unique
  userId             String?
  customerEmail      String
  customerName       String?
  customerPhone      String?
  transactionId      String    @unique
  dpaySessionId      String?   @unique
  dpayCheckoutUrl    String?
  dpayReference      String?
  dpayStatus         String?
  amountPkr          Int
  amountPaisa        Int
  payableAmountPaisa Int?
  amountPaidPaisa    Int?
  currency           String    @default("PKR")
  status             String    @default("CREATED")
  providerOrderNo    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  paidAt             DateTime?
  provisionedAt      DateTime?
  failedReason       String?
}

model Esim {
  id              String    @id @default(uuid())
  userId          String?
  orderId         String?
  customerEmail   String?
  yesimEsimId     String?
  yesimUserId     String?
  iccid           String    @unique
  imsi            String?
  msisdn          String?
  activePlanId    String?
  bundleName      String?
  activationCode  String
  qrCodeDataUrl   String
  flagImageUrl    String?
  iosTapLink      String?
  esimPassport    String?
  statusQr        String    @default("Released")
  isDeleted       Boolean   @default(false)
  isUnlimited     Boolean   @default(false)
  dataPackageMb   Float?
  dataLeftMb      Float?
  dataUsedMb      Float     @default(0)
  planActivatedAt DateTime?
  planExpiredAt   DateTime?
  apn             String?
  networkInfo     Json?
  isVoucher       Boolean   @default(false)
  voucherCode     String?
  voucherStatus   String?
  replacementCount Int      @default(0)
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model TopUp {
  id                 String    @id @default(uuid())
  topUpNumber        String    @unique
  publicAccessToken  String    @unique
  esimId             String?
  iccid              String
  userId             String?
  customerEmail      String?
  customerPhone      String?
  bundleId           String
  yesimPlanId        String
  bundleName         String
  transactionId      String    @unique
  dpaySessionId      String?   @unique
  dpayCheckoutUrl    String?
  dpayReference      String?
  dpayStatus         String?
  amountPkr          Int
  amountPaisa        Int
  payableAmountPaisa Int?
  amountPaidPaisa    Int?
  currency           String    @default("PKR")
  status             String    @default("CREATED")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  paidAt             DateTime?
  provisionedAt      DateTime?
  failedReason       String?
}

model WebhookEvent {
  id             String    @id @default(uuid())
  source         String    // "dpay" | "yesim"
  notifyId       String    @unique
  notifyType     String
  signatureValid Boolean   @default(true)
  payload        Json
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  error          String?
}
