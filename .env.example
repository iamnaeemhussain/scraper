# ==============================================================================
# Pak-Tel eSIM — Runtime Variables & Secrets Template
# Configure all secrets in Cloudflare Dashboard:
#   Workers & Pages -> <your-worker> -> Settings -> Variables and Secrets
# (For local development only, copy to untracked `.dev.vars` or `.env`)
# ==============================================================================

# --- Secret Admin Panel Route & Credentials (Required for Admin Access) ---
# Example: if ADMIN_SECRET_PATH=your-private-slug, Admin Panel is ONLY reachable
# at https://your-domain.com/your-private-slug (all other paths return 404).
ADMIN_SECRET_PATH=
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=

# --- Yesim Partner API (https://partners-api.yesim.biz) ---
YESIM_API_BASE_URL=https://partners-api.yesim.biz
YESIM_API_TOKEN=
YESIM_WEBHOOK_SECRET=

# --- DPay Pakistan PKR Checkout (https://api.dpay.com.pk/v1) ---
DPAY_API_BASE_URL=https://api.dpay.com.pk/v1
DPAY_MERCHANT_ID=
DPAY_API_KEY=
DPAY_API_SECRET=
DPAY_WEBHOOK_SECRET=

# --- Mailjet Send API v3.1 & Event Tracking Webhooks ---
# https://dev.mailjet.com/docs/email-api/webhooks/webhooks-overview
MAILJET_API_BASE_URL=https://api.mailjet.com
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=Pak-Tel eSIM
MAILJET_WEBHOOK_SECRET=

# --- Optional Public Storefront Variables ---
APP_PUBLIC_URL=
WHATSAPP_NUMBER=923259717066
