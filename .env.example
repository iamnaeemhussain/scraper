# ===== Server & URLs =====
NODE_ENV=development
PORT=3000
APP_BASE_URL=https://pak-tel.com
FRONTEND_URL=https://pak-tel.com
LOG_LEVEL=info

# ===== Database & Cache =====
# Production PostgreSQL URL (uses pg.Pool). If omitted locally, persistent embedded PostgreSQL (PGlite) is used automatically.
DATABASE_URL=postgresql://esim:esim@localhost:5432/esim?schema=public
REDIS_URL=redis://localhost:6379

# ===== Bootstrap Admin Account =====
ADMIN_EMAIL=admin@pak-tel.com
ADMIN_PASSWORD=change_me_strong_password

# ===== JWT Auth =====
JWT_ACCESS_SECRET=replace_with_32_byte_random_hex_access_secret
JWT_REFRESH_SECRET=replace_with_32_byte_random_hex_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ===== Storefront Defaults =====
STORE_NAME=Pak-Tel
STORE_TAGLINE=Pakistan's Cheapest Data eSIM Provider
WHATSAPP_CONTACT=923259717066
SUPPORT_EMAIL=support@pak-tel.com
EUR_TO_PKR_RATE=303.8602

# ===== Yesim Partner API (https://partners-api.yesim.biz) =====
YESIM_BASE_URL=https://partners-api.yesim.biz
YESIM_API_TOKEN=
YESIM_MOCK_MODE=true

# ===== DPay Pakistan Payment Gateway (https://api.dpay.com.pk/v1) =====
DPAY_BASE_URL=https://api.dpay.com.pk/v1
DPAY_API_KEY=
DPAY_WEBHOOK_SECRET=whsec_replace_with_dpay_webhook_secret
DPAY_MOCK_MODE=true

# ===== Transactional Email (Optional) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pak-Tel <support@pak-tel.com>"

# ===== Firebase Cloud Messaging (Optional Mobile Push) =====
FCM_SERVICE_ACCOUNT_PATH=
